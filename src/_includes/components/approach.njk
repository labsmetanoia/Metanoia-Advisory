{# Working approach: what you see | what works in the background, then the five stages. expects `ap`, `lang` #}
<div class="approach2">
  <div class="approach2__col">
    <p class="kicker">{{ ap.see.title | L(lang) }}</p>
    {% if ap.see.text %}<p class="approach__intro">{{ ap.see.text | L(lang) }}</p>{% endif %}
    <div class="approach2__pair">
      <div class="pcard">{% if ap.see.clientPhoto %}<img src="{{ ap.see.clientPhoto }}" alt="" loading="lazy" decoding="async">{% endif %}<span class="pcard__badge">{% set icon = "people" %}{% include "components/icon.njk" %}</span><div class="pcard__body"><strong>{{ ap.see.client | L(lang) }}</strong><span>{{ ap.see.clientText | L(lang) }}</span></div></div>
      <div class="approach2__arrow" aria-hidden="true"><span>→</span></div>
      <div class="pcard pcard--lead">{% if ap.see.leadPhoto %}<img src="{{ ap.see.leadPhoto }}" alt="" loading="lazy" decoding="async">{% endif %}<span class="pcard__badge">{% set icon = "diamond" %}{% include "components/icon.njk" %}</span><div class="pcard__body"><strong>{{ ap.see.lead | L(lang) }}</strong><span>{{ ap.see.leadText | L(lang) }}</span></div></div>
    </div>
    <ul class="approach2__list">{% for it in ap.see.items %}<li>{% set icon = it.icon %}{% include "components/icon.njk" %}<span>{{ it.text | L(lang) }}</span></li>{% endfor %}</ul>
  </div>
  <div class="approach2__col approach2__col--bg">
    <p class="kicker">{{ ap.background.title | L(lang) }}</p>
    {% if ap.background.text %}<p class="approach__intro">{{ ap.background.text | L(lang) }}</p>{% endif %}
    <div class="approach2__flow">
      <div class="pcard pcard--manager">{% if ap.background.pmoPhoto %}<img src="{{ ap.background.pmoPhoto }}" alt="" loading="lazy" decoding="async">{% endif %}<span class="pcard__badge">{% set icon = "doclist" %}{% include "components/icon.njk" %}</span><div class="pcard__body"><strong>{{ ap.background.pmo | L(lang) }}</strong><span>{{ ap.background.pmoText | L(lang) }}</span></div></div>
      <div class="approach2__spine" aria-hidden="true">{% for it in ap.background.items %}<i></i>{% endfor %}</div>
      <ul class="approach2__strips">{% for it in ap.background.items %}<li class="strip"><span class="strip__icon">{% set icon = it.icon %}{% include "components/icon.njk" %}</span><div class="strip__text"><strong>{{ it.title | L(lang) }}</strong><span>{{ it.text | L(lang) }}</span></div>{% if it.photo %}<img src="{{ it.photo }}" alt="" loading="lazy" decoding="async">{% endif %}</li>{% endfor %}</ul>
    </div>
  </div>
</div>
<div class="approach2__stages">
  <p class="kicker">{{ ap.stagesTitle | L(lang) }}</p>
  <ol class="stages stagger">{% for st in ap.stages %}<li class="stage"><span class="stage__num">{{ loop.index | pad2 }}</span>{% if st.photo %}<img class="stage__photo" src="{{ st.photo }}" alt="" loading="lazy" decoding="async">{% endif %}<div class="stage__body"><h3>{{ st.title | L(lang) }}</h3><p>{{ st.text | L(lang) }}</p></div></li>{% endfor %}</ol>
</div>

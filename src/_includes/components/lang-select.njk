{# Flag-based language selector. expects `lang`, `alternates`, optional `variant` ("menu" for the mobile menu, "footer") #}
{% set otherLang = "en" if lang == "id" else "id" %}
{% macro flag(code, uid) %}<svg class="flag" viewBox="0 0 40 40" aria-hidden="true" focusable="false"><defs><clipPath id="fc-{{ uid }}"><circle cx="20" cy="20" r="20"/></clipPath>{% if code == "en" %}<clipPath id="fx-{{ uid }}"><path d="M30 15h30v15zv15H0zH0V0zV0h30z" transform="translate(-20 0) scale(1.3334)"/></clipPath>{% endif %}</defs><g clip-path="url(#fc-{{ uid }})">{% if code == "id" %}<rect x="-10" y="0" width="60" height="40" fill="#fff"/><rect x="-10" y="0" width="60" height="20" fill="#CE1126"/>{% else %}<g transform="translate(-20 0) scale(1.3334)"><path d="M0 0v30h60V0z" fill="#012169"/><path d="M0 0l60 30m0-30L0 30" stroke="#fff" stroke-width="6"/><path d="M0 0l60 30m0-30L0 30" clip-path="url(#fx-{{ uid }})" stroke="#C8102E" stroke-width="4"/><path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="10"/><path d="M30 0v30M0 15h60" stroke="#C8102E" stroke-width="6"/></g>{% endif %}</g></svg>{% endmacro %}
<div class="langsel{% if variant %} langsel--{{ variant }}{% endif %}" data-langsel>
  <button type="button" class="langsel__btn" aria-haspopup="listbox" aria-expanded="false"><span class="visually-hidden">{{ ui | t(lang, 'labels.language') }}: </span>{{ flag(lang, (variant or "hdr") ~ "-b") }}<span class="langsel__code">{{ ui | t(lang, "langShort") }}</span><svg class="langsel__chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
  <ul class="langsel__menu" role="listbox" aria-label="{{ ui | t(lang, 'labels.language') }}" hidden>
    <li role="option" aria-selected="true"><a class="langsel__opt is-current" href="{{ page.url }}" lang="{{ lang }}" hreflang="{{ lang }}" aria-current="true">{{ flag(lang, (variant or "hdr") ~ "-c") }}<span class="langsel__code">{{ ui | t(lang, "langShort") }}</span><span class="langsel__name">{{ ui | t(lang, "langName") }}</span></a></li>
    <li role="option" aria-selected="false"><a href="{{ alternates[otherLang] }}" lang="{{ otherLang }}" hreflang="{{ otherLang }}" data-lang-switch="{{ otherLang }}" class="langsel__opt">{{ flag(otherLang, (variant or "hdr") ~ "-o") }}<span class="langsel__code">{{ ui | t(otherLang, "langShort") }}</span><span class="langsel__name">{{ ui | t(otherLang, "langName") }}</span></a></li>
  </ul>
</div>

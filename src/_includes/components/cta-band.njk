{% set cta = pages.home.cta %}
<section class="cta-band" aria-labelledby="cta-title">
  <div class="cta-band__visual{% if cta.photo %} cta-band__visual--photo{% endif %}" aria-hidden="true">{% if cta.photo %}<img src="{{ cta.photo }}" alt="" loading="lazy" decoding="async">{% else %}{% include "charts/artefact-session.njk" %}{% endif %}</div>
  <div class="wrap cta-band__inner">
    <div class="cta-band__text">
      <h2 id="cta-title" class="gold-em">{{ cta.title | L(lang) | mdInline | safe }}</h2>
      <p>{{ ui | t(lang, "closing.text") }}</p>
      <div class="cta-pillars">{% for pl in cta.pillars %}<div>{% set icon = pl.icon %}{% include "components/icon.njk" %}<div><strong>{{ pl.title | L(lang) }}</strong><span>{{ pl.text | L(lang) }}</span></div></div>{% endfor %}</div>
      <a class="btn btn--primary" href="{{ 'contact' | pageUrl(lang) }}#book" data-event="cta_click" data-location="closing-band">{{ ui | t(lang, "cta.talk") }} →</a>
    </div>
  </div>
</section>

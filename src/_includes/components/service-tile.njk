{# expects `s` (service), `lang` #}
<a class="tile{% if s.express %} tile--featured{% endif %}" href="{{ s | serviceUrl(lang) }}">
  {% set icon = s.icon %}{% include "components/icon.njk" %}
  {% if s.express %}<span class="tag tag--accent">{{ ui | t(lang, "labels.express") }}</span>{% endif %}
  <h3>{{ s.title | L(lang) }}</h3>
  <p>{{ s.tileLine | L(lang) }}</p>
</a>

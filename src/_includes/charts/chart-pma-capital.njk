{% set t = { "en": { "title": "The minimum paid-up capital for a foreign-owned PT PMA fell by 75% in October 2025", "src": "Source: BKPM Regulation 5/2025, in force October 2025, via ASEAN Briefing. IDR billion.", "a": "Before Oct 2025", "b": "From Oct 2025" },
             "id": { "title": "Modal disetor minimum PT PMA turun 75% pada Oktober 2025", "src": "Sumber: Peraturan BKPM 5/2025, berlaku Oktober 2025, via ASEAN Briefing. Miliar rupiah.", "a": "Sebelum Okt 2025", "b": "Sejak Okt 2025" } } %}
{% set tt = t[lang] %}
<figure class="chart">
  <p class="chart__title">{{ tt.title }}</p>
  <svg viewBox="0 0 560 190" role="img" aria-label="{{ tt.title }}. {{ tt.a }}: Rp10 billion. {{ tt.b }}: Rp2.5 billion.">
    <text x="0" y="40" class="ctxlbl">{{ tt.a }}</text>
    <rect x="160" y="20" width="360" height="32" class="ctx"></rect>
    <text x="330" y="42" class="lbl" style="fill:#fff">Rp10 {{ "bn" if lang == "en" else "miliar" }}</text>
    <text x="0" y="120" class="lbl">{{ tt.b }}</text>
    <rect x="160" y="100" width="90" height="32" class="acc"></rect>
    <text x="258" y="122" class="lbl">Rp2.5 {{ "bn" if lang == "en" else "miliar" }}</text>
    <line x1="160" y1="0" x2="160" y2="150" class="axis"></line>
    <text x="160" y="178" class="ctxlbl" style="font-size:11px">−75%</text>
  </svg>
  <p class="chart__source">{{ tt.src }}</p>
</figure>

{# Synthetic "before" slide: dense, decorative, no finding in the title. Figures are invented for illustration only. #}
<svg viewBox="0 0 640 360" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="background:#fff">
  <rect width="640" height="360" fill="#ffffff"/>
  <rect x="0" y="0" width="640" height="44" fill="#1a2b6d"/>
  <text x="20" y="29" font-family="Arial, sans-serif" font-size="18" font-weight="700" fill="#fff">FINANCIAL PERFORMANCE OVERVIEW – Q3</text>
  <rect x="560" y="8" width="60" height="28" fill="#f2a800"/>
  <text x="20" y="72" font-family="Arial" font-size="11" fill="#333">• Revenue growth continued in Q3 driven by strong performance across all segments</text>
  <text x="20" y="88" font-family="Arial" font-size="11" fill="#333">• EBITDA margin improved due to various operational efficiency initiatives</text>
  <text x="20" y="104" font-family="Arial" font-size="11" fill="#333">• Logistics costs normalised following the completion of network optimisation</text>
  <text x="20" y="120" font-family="Arial" font-size="11" fill="#333">• Management remains committed to delivering shareholder value going forward</text>
  {% for i in range(0, 3) %}
  <rect x="{{ 20 + i*205 }}" y="140" width="190" height="190" fill="#f4f4f4" stroke="#ccc"/>
  <text x="{{ 30 + i*205 }}" y="158" font-family="Arial" font-size="10" font-weight="700" fill="#1a2b6d">{{ ["REVENUE (IDR BN)", "EBITDA MARGIN (%)", "OPEX BREAKDOWN"][i] }}</text>
  {% endfor %}
  {% for v in [60, 72, 55, 80, 95, 110] %}<rect x="{{ 34 + loop.index0*27 }}" y="{{ 310 - v }}" width="18" height="{{ v }}" fill="{{ ['#1a2b6d','#f2a800','#4caf50','#e53935','#9c27b0','#00bcd4'][loop.index0] }}"/>{% endfor %}
  {% for v in [11, 12, 9, 10, 13, 14] %}<circle cx="{{ 240 + loop.index0*30 }}" cy="{{ 300 - v*8 }}" r="4" fill="#e53935"/>{% if not loop.first %}<line x1="{{ 210 + loop.index0*30 }}" y1="{{ 300 - [11,12,9,10,13,14][loop.index0-1]*8 }}" x2="{{ 240 + loop.index0*30 }}" y2="{{ 300 - v*8 }}" stroke="#e53935" stroke-width="2"/>{% endif %}{% endfor %}
  <circle cx="525" cy="245" r="60" fill="#1a2b6d"/><path d="M525 245 L585 245 A60 60 0 0 1 545 300 Z" fill="#f2a800"/><path d="M525 245 L545 300 A60 60 0 0 1 470 270 Z" fill="#4caf50"/><path d="M525 245 L470 270 A60 60 0 0 1 480 205 Z" fill="#e53935"/>
  <text x="20" y="350" font-family="Arial" font-size="8" fill="#999">Confidential – For internal use only – Page 14</text>
</svg>

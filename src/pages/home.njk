---
pagination: { data: langPages, size: 1, alias: p, addAllPagesToCollections: true }
pageKey: home
---
{% set c = pages.home %}
<section class="hero-stage hero-stage--image" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true"><img class="hero-bg__img" src="{{ c.hero.background.large }}" srcset="{{ c.hero.background.small }} 960w, {{ c.hero.background.large }} 1672w" sizes="100vw" alt="" width="1672" height="941" fetchpriority="high" decoding="async"><div class="hero-bg__veil"></div></div>
  <div class="wrap">
    <div class="hero-stage__text">
      <h1 id="hero-title" class="display">{{ c.hero.headline | L(lang) }}</h1>
      <p class="sub">{{ c.hero.sub | L(lang) }}</p>
      <p class="lede">{{ c.hero.text | L(lang) }}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="{{ 'contact' | pageUrl(lang) }}#book" data-event="cta_click" data-location="hero">{{ ui | t(lang, "cta.talk") }} →</a>
        {% if site.phase == 2 %}<a class="btn btn--secondary" href="{{ 'presentation' | pageUrl(lang) }}" data-event="cta_click" data-location="hero-secondary">{{ ui | t(lang, "cta.allServices") }}</a>{% endif %}
      </div>
    </div>
    <div class="fan fan--live" role="img" aria-label="{{ c.hero.fanCaption | L(lang) }}">
      {% for sl in c.hero.slides %}<div class="fan__card fan__card--img"><img src="{{ sl }}" alt="" width="1200" height="675" {% if loop.index == 3 %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async"></div>{% endfor %}
    </div>
  </div>
  <div class="arch">
    <div class="wrap arch__inner">
      <span class="kicker">{{ c.flagship.kicker | L(lang) }}</span>
      <h2>{{ c.flagship.title | L(lang) }}</h2>
      <p class="lede" style="margin:0 auto">{{ c.flagship.text | L(lang) }}</p>
      <ul class="arch__points">{% for pt in c.flagship.points %}<li><strong>{{ pt.title | L(lang) }}</strong>{{ pt.text | L(lang) }}</li>{% endfor %}</ul>
      <div class="hero__actions" style="justify-content:center;margin-top:var(--s-4)">
        <a class="btn btn--primary" href="{{ 'contact' | pageUrl(lang) }}#deck-review" data-event="cta_click" data-location="arch">{{ ui | t(lang, "cta.deckReview") }}</a>
        <a class="arrow-link" href="{{ 'presentation' | pageUrl(lang) }}">{{ site.practiceNames.presentation | L(lang) }}</a>
      </div>
    </div>
  </div>
</section>

{% if site.phase == 2 %}
<section class="section" aria-labelledby="portfolio-title" style="padding-top:var(--section)">
  <div class="wrap">
    <div class="svc-head fade-up">
      <div><span class="kicker kicker--rule">{{ "Our services" if lang == "en" else "Layanan kami" }}</span><h2 id="portfolio-title" style="font-size:clamp(34px,4.6vw,52px);line-height:1.05">{{ c.portfolio.title | L(lang) }}</h2><p class="lede">{{ c.portfolio.text | L(lang) }}</p></div>
      <div class="pillars">{% for pl in c.portfolio.pillars %}<div>{% set icon = pl.icon %}{% include "components/icon.njk" %}<div><strong>{{ pl.title | L(lang) }}</strong><span>{{ pl.text | L(lang) }}</span></div></div>{% endfor %}</div>
    </div>
    <div class="svc-grid stagger">{% for s in services | where("practice", "presentation") %}{% set num = loop.index %}{% include "components/service-tile.njk" %}{% endfor %}</div>
  </div>
</section>

{% set ai = c.ai %}{% set aiService = services | find("key", "pres-ai-express") %}{% include "components/ai-band.njk" %}

<section class="section" aria-labelledby="comp-title" style="padding-top:var(--section)">
  <div class="wrap grid">
    <div class="col-4 comp-intro fade-up"><span class="kicker kicker--rule">{{ ui | t(lang, "labels.complementary") }}</span><h2 id="comp-title" class="gold-em">{{ c.complementary.title | L(lang) | mdInline | safe }}</h2><p class="muted">{{ c.complementary.text | L(lang) }}</p>{% if c.complementary.photo %}<img class="comp-intro__photo" src="{{ c.complementary.photo }}" alt="" loading="lazy" decoding="async" width="357" height="263">{% endif %}</div>
    <div class="col-8"><div class="comp-grid stagger">{% for it in c.complementary.items %}<div class="card-cut comp-card">{% set icon = it.icon %}{% include "components/icon.njk" %}<h3>{{ it.title | L(lang) }}</h3><p>{{ it.text | L(lang) }}</p><a class="arrow-btn" href="{{ 'contact' | pageUrl(lang) }}#form" aria-label="{{ it.title | L(lang) }}">→</a><div class="cut" aria-hidden="true"><div class="cut__gold"></div><div class="cut__art cut__art--photo"><img src="{{ it.photo }}" alt="" loading="lazy" decoding="async"></div></div></div>{% endfor %}</div></div>
  </div>
</section>

<section class="approach-band fade-up" aria-labelledby="approach-title">
  <div class="wrap">
    <div class="section-head"><h2 id="approach-title" class="gold-em">{{ c.approach.title | L(lang) | mdInline | safe }}</h2><p class="meta measure">{{ c.approach.text | L(lang) }}</p></div>
    {% set ap = c.approach %}{% include "components/approach.njk" %}
  </div>
</section>

<section class="section" aria-labelledby="advisory-title" style="padding-top:var(--section)">
  <div class="wrap">
    <div class="svc-head fade-up"><div><span class="kicker kicker--rule">{{ "Advisory practices" if lang == "en" else "Praktik advisory" }}</span><h2 id="advisory-title" class="gold-em" style="font-size:clamp(34px,4.6vw,52px);line-height:1.05">{{ c.advisory.title | L(lang) | mdInline | safe }}</h2></div><p class="muted" style="border-left:1px solid var(--grey-2);padding-left:var(--s-3)">{{ c.advisory.text | L(lang) }}</p></div>
    <div class="adv-grid stagger">
      {% for pr in practices %}{% if not pr.flagship %}{% set hub = pages.hubs[pr.key] %}
      <div class="adv-card">
        <span class="kicker kicker--rule">{{ ui | t(lang, "labels.situations." + pr.situation) }}</span>
        <h3>{{ site.practiceNames[pr.key] | L(lang) }}</h3>
        <p class="lede">{{ hub.situationLine | L(lang) }}</p>
        <ul class="adv-list">{% for b in hub.doorBullets %}<li>{% set icon = hub.doorIcons[loop.index0] %}{% include "components/icon.njk" %}<span>{{ b | L(lang) }}</span></li>{% endfor %}</ul>
        <a class="btn btn--primary" href="{{ pr.key | pageUrl(lang) }}">{{ ui | t(lang, "cta.explore") }} →<span class="visually-hidden">: {{ site.practiceNames[pr.key] | L(lang) }}</span></a>
        <div class="cut" aria-hidden="true"><div class="cut__gold"></div><div class="cut__art cut__art--photo cut__art--full"><img src="{{ hub.photo }}" alt="" loading="lazy" decoding="async"></div><div class="cut__tag">{{ hub.tagline | L(lang) }}</div></div>
      </div>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>

<section class="id-band fade-up" aria-labelledby="id-title">
  <div class="wrap id-band__grid">
    <div class="id-band__copy">
      <span class="kicker kicker--rule">{{ c.indonesia.kicker | L(lang) }}</span>
      <h2 id="id-title" class="gold-em">{{ c.indonesia.title | L(lang) | mdInline | safe }}</h2>
      <p class="id-band__text">{{ c.indonesia.text | L(lang) }}</p>
      <ul class="id-band__points">{% for pt in c.indonesia.points %}<li><span class="id-band__tick" aria-hidden="true">✓</span>{{ pt | L(lang) }}</li>{% endfor %}</ul>
      <div class="cluster"><a class="btn btn--primary" href="{{ 'marketEntry' | pageUrl(lang) }}" data-event="cta_click" data-location="indonesia-band">{{ ui | t(lang, "cta.explore") }} <span aria-hidden="true">→</span></a><a class="btn btn--secondary" href="{{ 'contact' | pageUrl(lang) }}#book" data-event="cta_click" data-location="indonesia-band-secondary">{{ ui | t(lang, "cta.talk") }}</a></div>
    </div>
    <div class="id-band__visual" aria-hidden="true"><div class="id-band__frame"><img src="{{ c.indonesia.photo }}" alt="" width="1920" height="1080" loading="lazy" decoding="async"></div></div>
  </div>
</section>

<section class="section fade-up" aria-labelledby="insight-title" style="padding-top:var(--section)">
  <div class="wrap grid">
    <div class="col-6">
      {% set flagship = insights | where("type", "flagship") | first %}
      <span class="kicker">{{ ui | t(lang, "labels.flagship") }}</span>
      {% if flagship %}
      <h2 id="insight-title"><a class="link-ink" href="{{ 'insights' | itemUrl(flagship, lang) }}">{{ flagship.title | L(lang) }}</a></h2>
      <p>{{ flagship.summary | L(lang) }}</p>
      {% if flagship.forthcoming %}<p class="meta">{{ ui | t(lang, "labels.forthcoming") }}</p>{% elif flagship.pdf %}<a class="btn btn--secondary" href="{{ flagship.pdf }}" data-event="download" data-asset="{{ flagship.key }}">{{ ui | t(lang, "cta.download") }}</a>{% endif %}
      {% else %}
      <h2 id="insight-title">{{ c.insight.title | L(lang) }}</h2>
      <p>{{ c.insight.text | L(lang) }}</p>
      {% endif %}
    </div>
    <div class="col-6">
      <span class="kicker">{{ ui | t(lang, "labels.newsletter") }}</span>
      <h3>{{ c.newsletter.title | L(lang) }}</h3>
      <p class="muted">{{ c.newsletter.text | L(lang) }}</p>
      {% set uid = "nl-home" %}{% include "components/newsletter.njk" %}
    </div>
  </div>
</section>
{% else %}
<section class="section fade-up">
  <div class="wrap grid-3">
    {% for pr in practices %}{% set hub = pages.hubs[pr.key] %}
    <div class="practice-door"><h3>{{ site.practiceNames[pr.key] | L(lang) }}</h3><ul>{% for b in hub.doorBullets %}<li>{{ b | L(lang) }}</li>{% endfor %}</ul></div>
    {% endfor %}
  </div>
</section>
<section class="section fade-up"><div class="wrap"><div class="cluster">{% if site.calendarUrl %}<a class="btn btn--primary" href="{{ site.calendarUrl }}" data-event="outbound_calendar" rel="noopener">{{ ui | t(lang, "cta.talk") }}</a>{% endif %}{% if site.email %}<a class="btn btn--secondary" href="mailto:{{ site.email }}">{{ ui | t(lang, "cta.email") }}</a>{% endif %}</div></div></section>
{% endif %}

<script type="application/ld+json">{{ {
  "@context": "https://schema.org", "@type": "ProfessionalService", "name": site.name,
  "url": site.baseUrl + ('home' | pageUrl(lang)), "description": pageDescription,
  "areaServed": "ID", "address": { "@type": "PostalAddress", "addressLocality": "Jakarta", "addressCountry": "ID" },
  "sameAs": [site.linkedin] if site.linkedin else [],
  "knowsLanguage": ["id", "en"]
} | json | safe }}</script>

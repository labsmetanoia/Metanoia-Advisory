---
pagination: { data: langPages, size: 1, alias: p }
pageKey: home
---
{% set c = pages.home %}
<section class="hero-stage" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="hero-stage__text">
      <span class="kicker">{{ c.hero.kicker | L(lang) }}</span>
      <h1 id="hero-title" class="display">{{ c.hero.headline | L(lang) }}</h1>
      <p class="sub">{{ c.hero.sub | L(lang) }}</p>
      <p class="lede">{{ c.hero.text | L(lang) }}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="{{ 'contact' | pageUrl(lang) }}#book" data-event="cta_click" data-location="hero">{{ ui | t(lang, "cta.talk") }} →</a>
        {% if site.phase == 2 %}<a class="btn btn--secondary" href="{{ 'presentation' | pageUrl(lang) }}" data-event="cta_click" data-location="hero-secondary">{{ ui | t(lang, "cta.allServices") }}</a>{% endif %}
      </div>
    </div>
    <div class="fan" role="img" aria-label="{{ c.hero.fanCaption | L(lang) }}">
      <div class="fan__card">{% include "charts/artefact-report-spread.njk" %}</div>
      <div class="fan__card">{% include "charts/slide-after.njk" %}</div>
      <div class="fan__card">{% include "charts/artefact-deck-page.njk" %}</div>
      <div class="fan__card">{% include "charts/artefact-cover.njk" %}</div>
      <div class="fan__card">{% include "charts/artefact-calendar-slide.njk" %}</div>
    </div>
  </div>
  <div class="arch">
    <div class="wrap arch__inner">
      <span class="kicker">{{ c.flagship.kicker | L(lang) }}</span>
      <h2>{{ c.flagship.title | L(lang) }}</h2>
      <p class="lede" style="margin:0 auto">{{ c.flagship.text | L(lang) }}</p>
      <ul class="arch__points">{% for pt in c.flagship.points %}<li><strong>{{ pt.title | L(lang) }}</strong>{{ pt.text | L(lang) }}</li>{% endfor %}</ul>
      <div class="hero__actions" style="justify-content:center;margin-top:var(--s-4)">
        <a class="btn btn--primary" href="{{ 'contact' | pageUrl(lang) }}#deck-review" data-event="cta_click" data-location="arch">{{ ui | t(lang, "cta.deckReview") }}</a>
        <a class="arrow-link" href="{{ 'presentation' | pageUrl(lang) }}">{{ site.practiceNames.presentation | L(lang) }}</a>
      </div>
    </div>
  </div>
</section>

{% if site.phase == 2 %}
<section class="section fade-up" aria-labelledby="portfolio-title" style="padding-top:var(--section)">
  <div class="wrap">
    <div class="section-head"><h2 id="portfolio-title">{{ c.portfolio.title | L(lang) }}</h2><p class="meta measure">{{ c.portfolio.text | L(lang) }}</p></div>
    <div class="tile-grid">{% for s in services | where("practice", "presentation") %}{% include "components/service-tile.njk" %}{% endfor %}</div>
  </div>
</section>

{% set ai = c.ai %}{% set aiService = services | find("key", "pres-ai-express") %}{% include "components/ai-band.njk" %}

<section class="section fade-up" aria-labelledby="comp-title" style="padding-top:var(--section)">
  <div class="wrap grid">
    <div class="col-4"><span class="kicker">{{ ui | t(lang, "labels.complementary") }}</span><h2 id="comp-title">{{ c.complementary.title | L(lang) }}</h2><p class="muted">{{ c.complementary.text | L(lang) }}</p></div>
    <div class="col-8"><div class="comp-grid">{% for it in c.complementary.items %}<div class="comp-card">{% set icon = it.icon %}{% include "components/icon.njk" %}<div><h3>{{ it.title | L(lang) }}</h3><p>{{ it.text | L(lang) }}</p></div></div>{% endfor %}</div></div>
  </div>
</section>

<section class="band fade-up" aria-labelledby="approach-title">
  <div class="wrap">
    <div class="section-head"><h2 id="approach-title">{{ c.approach.title | L(lang) }}</h2><p class="meta measure">{{ c.approach.text | L(lang) }}</p></div>
    {% set ap = c.approach %}{% include "components/approach.njk" %}
  </div>
</section>

<section class="section fade-up" aria-labelledby="advisory-title" style="padding-top:var(--section)">
  <div class="wrap">
    <div class="section-head"><h2 id="advisory-title">{{ c.advisory.title | L(lang) }}</h2><p class="meta measure">{{ c.advisory.text | L(lang) }}</p></div>
    <div class="grid-2">
      {% for pr in practices %}{% if not pr.flagship %}{% set hub = pages.hubs[pr.key] %}
      <div class="practice-door">
        <span class="kicker">{{ ui | t(lang, "labels.situations." + pr.situation) }}</span>
        <h3>{{ site.practiceNames[pr.key] | L(lang) }}</h3>
        <p class="muted">{{ hub.situationLine | L(lang) }}</p>
        <ul>{% for b in hub.doorBullets %}<li>{{ b | L(lang) }}</li>{% endfor %}</ul>
        <a class="arrow-link" href="{{ pr.key | pageUrl(lang) }}">{{ site.practiceNames[pr.key] | L(lang) }}</a>
      </div>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>

{% set featured = cases | where("featuredHome", true) | first %}
{% if featured %}
<section class="band fade-up" aria-labelledby="featured-title">
  <div class="wrap grid">
    <div class="col-6">
      <span class="kicker">{{ ui | t(lang, "labels.featured") }} · {{ featured.sector | L(lang) }}{% if featured.illustrative %} · {{ ui | t(lang, "labels.illustrative") }}{% endif %}</span>
      <h2 id="featured-title"><a class="link-ink" href="{{ 'work' | itemUrl(featured, lang) }}">{{ featured.title | L(lang) }}</a></h2>
      <p>{{ featured.situationText | L(lang) }}</p>
      {% set o = featured.outcome %}{% include "components/outcome-figure.njk" %}
      <p style="margin-top:24px"><a class="arrow-link" href="{{ 'work' | itemUrl(featured, lang) }}">{{ ui | t(lang, "cta.readCase") }}</a></p>
    </div>
    <div class="col-6"><div class="artefact">{% include "charts/" + featured.artefacts[0].component + ".njk" %}</div></div>
  </div>
</section>
{% endif %}

<section class="section fade-up" aria-labelledby="insight-title" style="padding-top:var(--section)">
  <div class="wrap grid">
    <div class="col-6">
      {% set flagship = insights | where("type", "flagship") | first %}
      <span class="kicker">{{ ui | t(lang, "labels.flagship") }}</span>
      {% if flagship %}
      <h2 id="insight-title"><a class="link-ink" href="{{ 'insights' | itemUrl(flagship, lang) }}">{{ flagship.title | L(lang) }}</a></h2>
      <p>{{ flagship.summary | L(lang) }}</p>
      {% if flagship.forthcoming %}<p class="meta">{{ ui | t(lang, "labels.forthcoming") }}</p>{% elif flagship.pdf %}<a class="btn btn--secondary" href="{{ flagship.pdf }}" data-event="download" data-asset="{{ flagship.key }}">{{ ui | t(lang, "cta.download") }}</a>{% endif %}
      {% else %}
      <h2 id="insight-title">{{ c.insight.title | L(lang) }}</h2>
      <p>{{ c.insight.text | L(lang) }}</p>
      {% endif %}
    </div>
    <div class="col-6">
      <span class="kicker">{{ ui | t(lang, "labels.newsletter") }}</span>
      <h3>{{ c.newsletter.title | L(lang) }}</h3>
      <p class="muted">{{ c.newsletter.text | L(lang) }}</p>
      {% set uid = "nl-home" %}{% include "components/newsletter.njk" %}
    </div>
  </div>
</section>
{% else %}
<section class="section fade-up">
  <div class="wrap grid-3">
    {% for pr in practices %}{% set hub = pages.hubs[pr.key] %}
    <div class="practice-door"><h3>{{ site.practiceNames[pr.key] | L(lang) }}</h3><ul>{% for b in hub.doorBullets %}<li>{{ b | L(lang) }}</li>{% endfor %}</ul></div>
    {% endfor %}
  </div>
</section>
<section class="section fade-up"><div class="wrap"><div class="cluster">{% if site.calendarUrl %}<a class="btn btn--primary" href="{{ site.calendarUrl }}" data-event="outbound_calendar" rel="noopener">{{ ui | t(lang, "cta.talk") }}</a>{% endif %}{% if site.email %}<a class="btn btn--secondary" href="mailto:{{ site.email }}">{{ ui | t(lang, "cta.email") }}</a>{% endif %}</div></div></section>
{% endif %}

<script type="application/ld+json">{{ {
  "@context": "https://schema.org", "@type": "ProfessionalService", "name": site.name,
  "url": site.baseUrl + ('home' | pageUrl(lang)), "description": pageDescription,
  "areaServed": "ID", "address": { "@type": "PostalAddress", "addressLocality": "Jakarta", "addressCountry": "ID" },
  "sameAs": [site.linkedin] if site.linkedin else [],
  "knowsLanguage": ["id", "en"]
} | json | safe }}</script>

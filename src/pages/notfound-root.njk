---
permalink: /404.html
layout: false
---
<!doctype html>
<html lang="id" data-route="{{ site.route }}">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>404 — {{ site.name }}</title><meta name="robots" content="noindex"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="/assets/css/main.css">
<script>(function(){var m=location.pathname.match(/^\/(id|en)\//);if(m){document.documentElement.lang=m[1];document.addEventListener("DOMContentLoaded",function(){document.querySelectorAll("[data-l]").forEach(function(el){el.hidden=el.getAttribute("data-l")!==m[1];});});}})();</script></head>
<body>
<main class="wrap" style="padding-top:96px">
  <p class="wordmark" style="font-size:28px"><a class="link-ink" href="/">Metanoia<span class="wordmark__sub">Advisory</span></a></p>
  {% for l in langs %}
  <section data-l="{{ l }}" lang="{{ l }}" style="margin-top:48px">
    <h1>{{ ui | t(l, "notFound.title") }}</h1>
    <p class="lede">{{ ui | t(l, "notFound.text") }}</p>
    <p class="cluster" style="margin-top:24px"><a class="btn btn--secondary" href="{{ 'home' | pageUrl(l) }}">{{ ui | t(l, "cta.backHome") }}</a>{% if site.phase == 2 %}<a class="btn btn--secondary" href="{{ 'work' | pageUrl(l) }}">{{ ui | t(l, "nav.work") }}</a>{% endif %}<a class="btn btn--primary" href="{{ 'contact' | pageUrl(l) }}">{{ ui | t(l, "nav.contact") }}</a></p>
  </section>
  {% endfor %}
</main>
</body></html>

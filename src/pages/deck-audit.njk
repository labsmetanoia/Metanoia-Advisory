---
pagination: { data: langPages, size: 1, alias: p, addAllPagesToCollections: true }
pageKey: deckAudit
showCta: false
---
{% set a = pages.deckAudit %}{% set prName = site.practiceNames.presentation | L(lang) %}
{% set price = site.offers.deckAudit.price | L(lang) if site.offers and site.offers.deckAudit else "" %}
{% set hasForm = site.forms.provider != "none" %}
<section class="svc-hero" aria-labelledby="audit-title">
  <div class="svc-hero__grid">
    <div class="svc-hero__copy">
      {% set crumbs = [{ name: prName, url: "presentation" | pageUrl(lang) }, { name: a.name | L(lang) }] %}
      {% include "components/breadcrumb.njk" %}
      <span class="rule-gold rule-gold--short" aria-hidden="true"></span>
      <h1 id="audit-title" class="gold-em">{{ a.hero.title | L(lang) | mdInline | safe }}</h1>
      <p class="lede">{{ a.hero.lede | L(lang) | mc(a.hero.ledeM | L(lang)) | safe }}</p>
      <div class="svc-hero__actions">
        {% if hasForm %}<a class="btn btn--primary" href="#audit-form" data-event="cta_click" data-location="deck-audit-hero"><span>{{ a.hero.button | L(lang) }}</span><span class="btn__arrow" aria-hidden="true">→</span></a>
        {% elif site.email %}<a class="btn btn--primary" href="mailto:{{ site.email }}?subject={{ a.name | L(lang) | urlencode }}" data-event="cta_click" data-location="deck-audit-hero"><span>{{ a.hero.button | L(lang) }}</span><span class="btn__arrow" aria-hidden="true">→</span></a>{% endif %}
        <a class="btn btn--secondary" href="{{ a.sampleReport.file | L(lang) }}" data-event="download" data-asset="deck-audit-sample"><span>{{ a.hero.sample | L(lang) }}</span><span class="btn__arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="svc-hero__media" aria-hidden="true"><img src="{{ a.hero.photo }}" alt="" width="1000" height="598" fetchpriority="high" decoding="async"></div>
  </div>
</section>

<section class="section svc-facts fade-up" aria-labelledby="audit-checks-title">
  <div class="wrap">
    <div class="svc4-head svc4-head--solo"><h2 id="audit-checks-title">{{ a.checks.label | L(lang) }}</h2></div>
    <div class="svc-facts__grid">
      {% for c in a.checks.items %}
      <div class="fact">
        <div class="fact__index" aria-hidden="true"><span>{{ loop.index | pad2 }}</span></div>
        <div class="fact__head"><span class="disc-tint">{% set icon = c.icon %}{% include "components/icon.njk" %}</span><h3>{{ c.title | L(lang) }}</h3></div>
        <ul class="fact__list">{% for li in c.list %}<li>{{ li | L(lang) }}</li>{% endfor %}</ul>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="svc-artefact audit-sample fade-up" aria-labelledby="audit-sample-title">
  <div class="wrap svc-artefact__grid">
    <div class="svc-artefact__copy"><h2 id="audit-sample-title">{{ a.sampleReport.title | L(lang) }}</h2><span class="rule-gold rule-gold--short" aria-hidden="true"></span><p>{{ a.sampleReport.text | L(lang) }}</p>
      <p class="audit-sample__cta"><a class="btn btn--primary" href="{{ a.sampleReport.file | L(lang) }}" data-event="download" data-asset="deck-audit-sample"><span>{{ a.sampleReport.button | L(lang) }}</span><span class="btn__arrow" aria-hidden="true">→</span></a></p></div>
    <figure class="svc-artefact__card"><div class="svc-artefact__chart"><a href="{{ a.sampleReport.file | L(lang) }}" data-event="download" data-asset="deck-audit-sample"><img src="{{ a.sampleReport.image | L(lang) }}" srcset="{{ a.sampleReport.imageSmall | L(lang) }} 1000w, {{ a.sampleReport.image | L(lang) }} 1536w" sizes="(min-width: 1024px) 60vw, 100vw" alt="{{ a.sampleReport.alt | L(lang) }}" width="1536" height="1024" loading="lazy" decoding="async"></a></div><figcaption class="svc-artefact__caption"><span class="svc-artefact__ci" aria-hidden="true">{% set icon = "doc" %}{% include "components/icon.njk" %}</span>{{ a.sampleReport.caption | L(lang) }}</figcaption></figure>
  </div>
</section>

<section class="section audit-run fade-up" aria-labelledby="audit-run-title">
  <div class="wrap">
    <div class="svc4-head svc4-head--solo"><h2 id="audit-run-title">{{ a.process.title | L(lang) }}</h2></div>
    <ol class="deck-steps">{% for st in a.process.steps %}<li><div class="fact__index" aria-hidden="true"><span>{{ loop.index | pad2 }}</span></div><div class="deck-steps__body"><span class="disc-tint">{% set icon = st.icon %}{% include "components/icon.njk" %}</span><div><h3>{{ st.title | L(lang) }}</h3><p>{{ st.text | L(lang) }}</p></div></div></li>{% endfor %}</ol>
    <h3 class="visually-hidden">{{ a.terms.title | L(lang) }}</h3>
    <dl class="audit-terms">{% for t in a.terms.items %}<div><dt>{{ t.label | L(lang) }}</dt><dd>{% if t.key == "fee" and price %}{{ price }}{% else %}{{ t.text | L(lang) }}{% endif %}</dd></div>{% endfor %}</dl>
  </div>
</section>

<section class="band audit-limits fade-up" aria-labelledby="audit-limits-title">
  <div class="wrap audit-limits__grid">
    <div><h2 id="audit-limits-title">{{ a.limits.title | L(lang) }}</h2><span class="rule-gold rule-gold--short" aria-hidden="true"></span></div>
    <div>
      <ul class="audit-limits__list">{% for li in a.limits.items %}<li>{{ li | L(lang) }}</li>{% endfor %}</ul>
      <p class="audit-limits__free">{{ a.limits.free | L(lang) }} <a href="{{ 'contact' | pageUrl(lang) }}#deck-review" data-event="cta_click" data-location="deck-audit-free">{{ a.limits.freeLink | L(lang) }}</a> · <a href="{{ 'presentation' | pageUrl(lang) }}">{{ a.limits.services | L(lang) }}</a>{% if site.tools.deckCheck == "live" %} · <a href="{{ 'deckCheck' | pageUrl(lang) }}" data-event="cta_click" data-location="deck-audit-check">{{ a.limits.check | L(lang) }}</a>{% endif %}</p>
    </div>
  </div>
</section>

{% set faqKey = "deckAudit" %}{% include "components/faq.njk" %}

<section class="section audit-request fade-up" id="audit-form-section" aria-labelledby="audit-request-title">
  <div class="wrap audit-request__grid">
    <div class="audit-request__copy"><span class="kicker">{{ a.name | L(lang) }}</span><h2 id="audit-request-title">{{ a.form.title | L(lang) }}</h2><span class="rule-gold rule-gold--short" aria-hidden="true"></span><p>{{ a.form.text | L(lang) }}</p>
      {% if not hasForm and site.email %}<p><a class="btn btn--primary" href="mailto:{{ site.email }}?subject={{ a.name | L(lang) | urlencode }}" data-event="cta_click" data-location="deck-audit-form"><span>{{ a.form.mail | L(lang) }}</span><span class="btn__arrow" aria-hidden="true">→</span></a></p>{% endif %}</div>
    {% if hasForm %}
    <div>
    <form class="form form--compact" id="audit-form" {% set formKey = "deckAudit" %}{% include "components/form-attrs.njk" %} data-form-type="deck_audit" novalidate>
      <div class="form__row">
        <div class="field"><label for="a-name" class="visually-hidden">{{ ui | t(lang, "form.name") }}</label><input id="a-name" name="name" type="text" required autocomplete="name" placeholder="{{ ui | t(lang, 'form.name') }}"><span class="field__error" role="alert">{{ ui | t(lang, "form.errors.name") }}</span></div>
        <div class="field"><label for="a-company" class="visually-hidden">{{ ui | t(lang, "form.company") }}</label><input id="a-company" name="company" type="text" required autocomplete="organization" placeholder="{{ ui | t(lang, 'form.company') }}"><span class="field__error" role="alert">{{ ui | t(lang, "form.errors.company") }}</span></div>
      </div>
      <div class="form__row">
        <div class="field"><label for="a-email" class="visually-hidden">{{ ui | t(lang, "form.email") }}</label><input id="a-email" name="email" type="email" required autocomplete="email" placeholder="{{ ui | t(lang, 'form.email') }}"><span class="field__error" role="alert">{{ ui | t(lang, "form.errors.email") }}</span></div>
        <div class="field"><label for="a-due" class="visually-hidden">{{ a.form.due | L(lang) }}</label><input id="a-due" name="deck_due" type="text" placeholder="{{ a.form.due | L(lang) }}"></div>
      </div>
      <div class="field"><label for="a-link" class="visually-hidden">{{ ui | t(lang, "form.deckLink") }}</label><input id="a-link" name="deck_link" type="url" placeholder="{{ ui | t(lang, 'form.deckLink') }}"></div>
      <div class="field"><label for="a-message" class="visually-hidden">{{ a.form.message | L(lang) }}</label><textarea id="a-message" name="message" rows="3" placeholder="{{ a.form.message | L(lang) }}"></textarea></div>
      <div class="field field--check"><input id="a-consent" name="consent" type="checkbox" required><label for="a-consent">{{ ui | t(lang, "form.consent") }}</label><span class="field__error" role="alert">{{ ui | t(lang, "form.errors.consent") }}</span></div>
      {% set formKey = "deckAudit" %}{% include "components/form-hidden.njk" %}
      <div><button class="btn btn--primary" type="submit" data-label="{{ a.hero.button | L(lang) }}" data-submitting="{{ ui | t(lang, 'form.submitting') }}">{{ a.hero.button | L(lang) }}</button></div>
      <p class="form__status" role="alert" data-generic="{{ ui | t(lang, 'form.errors.generic') }}"></p>
    </form>
    <div class="form__success" data-success hidden><h3>{{ ui | t(lang, "form.success.title") }}</h3><p>{{ a.form.success | L(lang) }}</p></div>
    </div>
    {% endif %}
  </div>
</section>

<script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "Service", "name": a.name | L(lang), "serviceType": a.name | L(lang), "description": a.metaDescription | L(lang), "provider": { "@type": "Organization", "name": site.name, "url": site.baseUrl }, "areaServed": "ID", "url": site.baseUrl + ("deckAudit" | pageUrl(lang)) } | json | safe }}</script>

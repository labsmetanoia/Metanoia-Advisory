---
pagination: { data: casePages, size: 1, alias: p }
pageKey: case
---
{% set cs = p.item %}
{% set bodyAttrs = 'data-case="' + cs.slug[lang] + '"' %}
<article>
<section class="page-hero" style="margin-bottom:64px">
  <div class="wrap">
    {% set crumbs = [{ name: ui | t(lang, "nav.work"), url: 'work' | pageUrl(lang) }, { name: cs.title | L(lang) }] %}
    {% include "components/breadcrumb.njk" %}
    {% if cs.illustrative %}<div class="notice"><strong>{{ ui | t(lang, "labels.illustrative") }}.</strong> {{ ui | t(lang, "labels.illustrativeText") }}</div>{% endif %}
    <h1 style="max-width:22ch">{{ cs.title | L(lang) }}</h1>
    <dl class="cluster meta" style="gap:8px 32px;margin-top:16px">
      <div><dt class="visually-hidden">{{ ui | t(lang, "labels.sector") }}</dt><dd style="margin:0"><span class="tag">{{ cs.sector | L(lang) }}</span></dd></div>
      <div><dt class="visually-hidden">{{ ui | t(lang, "labels.situation") }}</dt><dd style="margin:0">{{ ui | t(lang, "labels.situations." + cs.situation) }}</dd></div>
      <div><dt class="visually-hidden">{{ ui | t(lang, "labels.practices") }}</dt><dd style="margin:0">{% for pk in cs.practices %}{{ site.practiceNames[pk] | L(lang) }}{% if not loop.last %} · {% endif %}{% endfor %}</dd></div>
      <div><dt class="visually-hidden">{{ ui | t(lang, "labels.year") }}</dt><dd style="margin:0">{{ cs.year }}</dd></div>
      {% if cs.permission and cs.client %}<div><dt class="visually-hidden">Client</dt><dd style="margin:0">{{ cs.client }}</dd></div>{% endif %}
    </dl>
  </div>
</section>
<section class="section fade-up"><div class="wrap grid"><div class="col-4"><h2>{{ ui | t(lang, "labels.situation") }}</h2></div><div class="col-8 measure"><p class="lede">{{ cs.situationText | L(lang) }}</p></div></div></section>
<section class="section fade-up"><div class="wrap grid"><div class="col-4"><h2>{{ ui | t(lang, "labels.decision") }}</h2></div><div class="col-8 measure">{{ cs.decision | L(lang) | md | safe }}</div></div></section>
<section class="section fade-up">
  <div class="wrap grid">
    <div class="col-4"><h2>{{ ui | t(lang, "labels.built") }}</h2><div class="measure">{{ cs.built | L(lang) | md | safe }}</div></div>
    <div class="col-8 stack">{% for a in cs.artefacts %}<figure><div class="{{ "artefact" if a.frame }}">{% include "charts/" + a.component + ".njk" %}</div><figcaption>{{ a.caption | L(lang) }}</figcaption></figure>{% endfor %}</div>
  </div>
</section>
<section class="band fade-up">
  <div class="wrap grid">
    <div class="col-4"><h2>{{ ui | t(lang, "labels.outcome") }}</h2><p class="lede">{{ cs.outcomeLine | L(lang) }}</p></div>
    <div class="col-8">{% set o = cs.outcome %}{% include "components/outcome-figure.njk" %}</div>
  </div>
</section>
<section class="section fade-up">
  <div class="wrap grid">
    <div class="col-6"><h2 style="font-size:var(--fs-h3);line-height:var(--lh-h3)">{{ ui | t(lang, "labels.involved") }}</h2>
      <ul>{% for sk in cs.relatedServices %}{% set s = services | find("key", sk) %}{% if s %}<li><a href="{{ s | serviceUrl(lang) }}">{{ s.title | L(lang) }}</a> <span class="meta">· {{ site.practiceNames[s.practice] | L(lang) }}</span></li>{% endif %}{% endfor %}</ul>
      {% if cs.relatedPeople %}<div class="cluster" style="margin-top:16px">{% for pk in cs.relatedPeople %}{% set person = people | find("key", pk) %}{% if person %}<a class="author-chip" href="{{ 'people' | itemUrl(person, lang) }}"><span class="avatar" aria-hidden="true">{{ person.name | initials }}</span>{{ person.name }}</a>{% endif %}{% endfor %}</div>{% endif %}
    </div>
    <div class="col-6"><div class="statement"><h3>{{ ui | t(lang, "cta.similar") }}</h3><p class="muted">{{ ui | t(lang, "closing.text") }}</p><a class="btn btn--primary" href="{{ 'contact' | pageUrl(lang) }}?situation={{ cs.situation }}#book" data-event="cta_click" data-location="case-similar">{{ ui | t(lang, "cta.talk") }}</a></div></div>
  </div>
</section>
{% if p.next and p.next.key != cs.key %}
<section class="section fade-up"><div class="wrap"><div class="section-head"><h2>{{ ui | t(lang, "labels.nextCase") }}</h2><a class="arrow-link" href="{{ 'work' | pageUrl(lang) }}">{{ ui | t(lang, "cta.allWork") }}</a></div><div class="grid-2">{% set c = p.next %}{% include "components/case-card.njk" %}</div></div></section>
{% endif %}
</article>
<script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "Article", "headline": cs.title | L(lang), "description": cs.metaDescription | L(lang), "datePublished": cs.year + "-01-01", "inLanguage": lang, "author": { "@type": "Organization", "name": site.name }, "publisher": { "@type": "Organization", "name": site.name }, "mainEntityOfPage": site.baseUrl + page.url } | json | safe }}</script>

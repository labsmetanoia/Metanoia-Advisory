---
pagination: { data: langPages, size: 1, alias: p, addAllPagesToCollections: true }
pageKey: notfound
showCta: false
---
<section class="section">
  <div class="wrap">
    <h1>{{ ui | t(lang, "notFound.title") }}</h1>
    <p class="lede">{{ ui | t(lang, "notFound.text") }}</p>
    <p class="cluster" style="margin-top:24px"><a class="btn btn--secondary" href="{{ 'home' | pageUrl(lang) }}">{{ ui | t(lang, "cta.backHome") }}</a><a class="btn btn--primary" href="{{ 'contact' | pageUrl(lang) }}">{{ ui | t(lang, "nav.contact") }}</a></p>
  </div>
</section>
